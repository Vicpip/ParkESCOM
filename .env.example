# Copia este archivo como .env y llena los valores. El .env nunca se sube a Git.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Opcional: puerto del host para la base (5432 si se deja vacío)
POSTGRES_PORT=

# Conexión de la API y de las pruebas: postgres://usuario:password@host:5432/base
# La base de DATABASE_URL_TEST se borra y se recrea en cada corrida de pruebas.
DATABASE_URL=
DATABASE_URL_TEST=

# JWT de acceso (HS256): al menos 32 caracteres aleatorios.
# El refresh token es opaco y no usa secreto: en la base solo se guarda su hash.
JWT_ACCESS_SECRET=

# Dominios de correo con los que se puede registrar una cuenta, separados por
# comas. Ejemplo: ipn.mx,alumno.ipn.mx
ALLOWED_EMAIL_DOMAINS=

# Contraseña de las cuentas de demostración (dart run bin/seed_usuarios.dart).
# Mínimo 8 caracteres, con al menos una letra y un número.
SEED_PASSWORD=

# Pases de visitante (EdDSA)
PASES_PRIVATE_KEY=
PASES_PUBLIC_KEY=

# Entorno de la API: desarrollo o produccion. Si se deja vacío se asume
# produccion, que es el valor seguro.
#   desarrollo: sin SMTP_HOST, el enlace de recuperación de contraseña se
#               imprime en la consola de la API en vez de enviarse.
#   produccion: nunca se imprime un enlace ni un token, y la API no arranca
#               si falta SMTP_HOST.
ENTORNO=

# Correo de recuperación de contraseña (SMTP). SMTP_PORT es opcional (587 por
# defecto; con 465 se usa TLS desde el inicio). SMTP_FROM es la dirección del
# remitente y es obligatoria cuando hay SMTP_HOST.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# URL pública del panel web: enlaces de los correos y único origen que CORS
# deja llamar a la API. Ejemplo: https://parkescom.example.com
APP_WEB_URL=

# Carpeta donde se guardan las fotos. Opcional: ./uploads por defecto (queda
# en backend/uploads al correr la API en local y está en .gitignore).
UPLOADS_DIR=
